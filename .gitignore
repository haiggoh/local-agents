# Your private overlay — NEVER published (this is the whole point of the overlay design).
# Pattern, not a single name: any new *.local.* overlay (e.g. a private model catalog)
# must be ignored the moment it is created, not the day someone remembers to list it.
config/*.local.*
config/config.local.sh

# runtime / backups / caches
*.bak
*.bak-*
__pycache__/
*.pyc
*.log
.DS_Store
.pytest_cache/
backups/

# Local model audit dumps. These are AUDIT OUTPUT, not source: plan §16 excludes audit output from
# staged paths, and one of them is ~1.5MB of raw scan. The reviewed catalogue distilled from them
# (config/model-catalogue-context-list.yaml) IS tracked; the raw dumps are not.
config/local-model-audit-condensed.txt
config/local-model-autit-check.txt
